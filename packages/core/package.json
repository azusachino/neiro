{
  "name": "tsuzuri",
  "version": "0.6.0",
  "description": "An SDK and CLI for reading and capturing into an Obsidian-compatible Markdown vault",
  "type": "module",
  "private": true,
  "module": "./dist/lib/index.js",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./tools": {
      "bun": "./src/tools.ts",
      "types": "./dist/lib/tools.d.ts",
      "default": "./dist/lib/tools.js"
    }
  },
  "bin": {
    "tsuzuri": "./dist/lib/cli.js",
    "tsuzuri-tools": "./dist/lib/tools-cli.js"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24"
  },
  "scripts": {
    "build": "bun build --compile src/cli.ts --outfile dist/tsuzuri",
    "build:lib": "tsc -p tsconfig.build.json && bun build src/cli.ts src/tools-cli.ts --target=node --packages=external --outdir dist/lib",
    "prepack": "bun run build:lib"
  },
  "dependencies": {
    "diff": "9.0.0",
    "ignore": "7.0.9",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azusachino/tsuzuri.git"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "notes",
    "cli",
    "sdk",
    "bun",
    "agent",
    "tools",
    "mcp"
  ],
  "types": "./dist/lib/index.d.ts",
  "files": [
    "dist/lib",
    "src"
  ]
}
