{
  "name": "neiro-tools",
  "version": "0.5.0",
  "description": "Agent tool definitions over neiro's SDK: names, JSON Schemas, MCP-style hints, and a default exposure",
  "type": "module",
  "private": true,
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "bin": {
    "neiro-tools": "./dist/lib/cli.js"
  },
  "files": [
    "dist/lib",
    "src"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24"
  },
  "scripts": {
    "build:lib": "tsc -p tsconfig.build.json && bun build src/cli.ts --target=node --packages=external --outfile dist/lib/cli.js",
    "prepack": "bun run build:lib"
  },
  "dependencies": {
    "neiro": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azusachino/neiro.git"
  },
  "keywords": [
    "obsidian",
    "agent",
    "tools",
    "mcp",
    "neiro"
  ]
}
